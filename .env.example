APP_NAME="Netcell Pay"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://netcellpay.in

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
RECHARGE_API_CONNECT_TIMEOUT=10
RECHARGE_API_TIMEOUT=30

# Optional override for mobile plan list API (server-side only).
# Verified working base: https://www.mplan.in/api
# Broken/dead base (HTML 404): http://planapi.in/api
PLAN_API_BASE_URL=
PLAN_API_KEY=
PLAN_API_CONNECT_TIMEOUT=10
PLAN_API_TIMEOUT=30

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@netcellpay.in"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase Cloud Messaging server key for Android app push notifications.
FCM_SERVER_KEY=

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Keep /admin on the admin Laravel app
    RewriteRule ^admin(/|$) - [L]

    # Always send site traffic into /public (fixes Hostinger 403 on /)
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

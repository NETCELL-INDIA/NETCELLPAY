<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Keep /admin on the admin Laravel app (do not send to /public)
    RewriteRule ^admin(/|$) - [L]

    # Keep real files/folders in project root
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send all other traffic to Laravel public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Deny access to sensitive files if exposed
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
